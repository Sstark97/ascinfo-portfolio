# Notion Integration Configuration
# Create an integration at: https://www.notion.so/my-integrations
NOTION_API_KEY=secret_your_notion_integration_token_here

# Database IDs (found in the URL of your Notion database)
# Example: https://notion.so/workspace/DATABASE_ID?v=...
NOTION_POSTS_DATABASE_ID=your_posts_database_id_here
NOTION_PRESENTATIONS_DATABASE_ID=your_presentations_database_id_here
NOTION_PROJECTS_DATABASE_ID=your_projects_database_id_here

# Optional: Enable image download during build (recommended)
# When true, images from Notion will be downloaded and optimized by Astro
NOTION_DOWNLOAD_IMAGES=true
